# Copy to .env.local and fill in real values (never commit .env.local)

# Payload CMS admin (/admin). Any long random string works for the
# secret. Without DATABASE_URL, Payload runs on a local SQLite file —
# fine for development, but Vercel's filesystem is ephemeral, so
# production needs a real Postgres connection string (Neon via the
# Vercel Marketplace is the simplest path) plus Vercel Blob storage for
# uploaded images to persist.
PAYLOAD_SECRET=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# resend.com dashboard > API Keys — contact formulier
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_ALERT_EMAIL=info@bureauthinkpositive.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000
